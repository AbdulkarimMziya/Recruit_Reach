# Copy this file to .env and fill in real values. .env is never committed.

# Django's own secret, used for signing. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Your OWN Gemini API key (free): https://aistudio.google.com/apikey
AI_API_KEY=
# A Gemini Flash-Lite model works well, e.g. gemini-3.5-flash-lite
AI_MODEL=

# Redis caches AI results (e.g. a sorted resume) for 24 hours.
# Locally: brew install redis && brew services start redis
# Leave empty to use Django's simple in-memory cache instead.
REDIS_URL=redis://127.0.0.1:6379/0
